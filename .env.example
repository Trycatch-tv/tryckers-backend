# Backend local (Dev) conectado a Amazon S3 Dev (sin EC2/RDS/CloudFront)
PORT=8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tryckers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-local-secret
FRONTEND_URL=http://localhost:4200

# Almacenamiento multimedia S3 Dev (usa perfil/credenciales temporales de AWS CLI)
STORAGE_DRIVER=s3
AWS_REGION=us-west-2
S3_BUCKET=tryckers-media-storage-dev
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
